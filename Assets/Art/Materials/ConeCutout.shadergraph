        }
    },
    "m_Slots": [
        {
            "m_Id": "0e7986740afa44b18b09508015fc9e7c"
        },
        {
            "m_Id": "8c4684f8fc524ce6a35a0fc8df92b749"
        },
        {
            "m_Id": "e844ba0173eb4bd6924df969ffc53c8d"
        },
        {
            "m_Id": "c4ac7ba09cdb457b95eaa6d0075de22c"
        },
        {
            "m_Id": "71e5093fb10b4964aa614d6649db501e"
        },
        {
            "m_Id": "4da974eaa0de44da8fa46b79012e73f9"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CylinderDist",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 camToPlayer = _PlayerPos.xyz + float3(0,1,0) - _WorldSpaceCameraPos;\r\nfloat3 axisDir = normalize(camToPlayer);\r\nfloat segmentLen = length(camToPlayer) - 3.5;\r\nfloat3 camToFrag = IN_WorldPos - _WorldSpaceCameraPos;\r\nfloat t = dot(camToFrag, axisDir);\nt = clamp(t, 0.0, segmentLen);\r\nfloat3 closest = _WorldSpaceCameraPos + axisDir * t;\r\nDist = length(IN_WorldPos - closest);"
}

