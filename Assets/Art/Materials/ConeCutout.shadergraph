{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "0a0e3f0a6d424addbbfd7ba709717234",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CylinderDist (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1210.0,
            "y": 144.0,
